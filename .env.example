# Copy to .env and fill in.

# ---- LLM (any OpenAI-compatible API; the model must support tool/function calling) ----
# OpenAI
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Groq (free tier) — check console.groq.com for current model names
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=<a tool-calling Llama model listed in your Groq console>

# Ollama (fully local, no key): `ollama pull llama3.1` first
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.1

# ---- Retrieval ----
EMBED_BACKEND=st                       # st = sentence-transformers, tfidf = offline fallback
EMBED_MODEL=BAAI/bge-small-en-v1.5
RERANK_MODEL=BAAI/bge-reranker-base    # leave empty to disable
